{
  "task": "flutterguard-idea-plugin-bootstrap",
  "description": "Create JetBrains IntelliJ IDEA plugin that wraps flutterguard CLI as a native inspection provider. Reads --format json --stdout output, maps to IDE inspections. Uses Gradle + kotlin, bundles native binaries per platform.",
  "target_dir": "idea-plugin/",
  "prerequisite": "dart analyze && dart test (from repo root)",
  "steps": [
    {
      "id": "1-init-gradle",
      "action": "create_gradle_project",
      "target": "idea-plugin/",
      "spec": {
        "settings.gradle.kts": "rootProject.name = 'flutterguard-idea'",
        "build.gradle.kts": [
          "plugins {",
          "  id('java')",
          "  id('org.jetbrains.intellij') version '1.17.4'",
          "  id('org.jetbrains.kotlin.jvm') version '2.0.21'",
          "}",
          "",
          "group = 'com.flutterguard'",
          "version = System.getenv('PLUGIN_VERSION') ?: '0.0.0'",
          "",
          "repositories { mavenCentral() }",
          "",
          "intellij {",
          "  version.set('2024.3')",
          "  type.set('IC')",
          "  plugins.set(listOf())",
          "}",
          "",
          "tasks {",
          "  patchPluginXml {",
          "    sinceBuild.set('243')",
          "    untilBuild.set('')",
          "  }",
          "  signPlugin {",
          "    certificateChain.set(System.getenv('CERTIFICATE_CHAIN'))",
          "    privateKey.set(System.getenv('PRIVATE_KEY'))",
          "    password.set(System.getenv('PRIVATE_KEY_PASSWORD'))",
          "  }",
          "  publishPlugin {",
          "    token.set(System.getenv('ORG_GRADLE_PROJECT_intellijPublishToken'))",
          "  }",
          "}"
        ],
        "gradle.properties": [
          "kotlin.code.style=official",
          "org.gradle.jvmargs=-Xmx2g"
        ]
      }
    },
    {
      "id": "2-plugin-xml",
      "action": "write_file",
      "target": "idea-plugin/src/main/resources/META-INF/plugin.xml",
      "content": "<idea-plugin>\n  <id>com.flutterguard</id>\n  <name>FlutterGuard</name>\n  <vendor url=\"https://github.com/lizy-coding/flutterguard\">FlutterGuard</vendor>\n\n  <description><![CDATA[\nStatic analysis for IoT/smart-home Flutter projects.\nDetects architecture boundary violations, lifecycle risks,\nIoT security issues, and state management problems.\n  ]]></description>\n\n  <depends>com.intellij.modules.platform</depends>\n\n  <extensions defaultExtensionNs=\"com.intellij\">\n    <externalAnnotator\n      language=\"Dart\"\n      implementationClass=\"com.flutterguard.FlutterGuardExternalAnnotator\"/>\n    <projectService\n      serviceImplementation=\"com.flutterguard.FlutterGuardSettings\"/>\n  </extensions>\n\n  <projectListeners>\n    <listener class=\"com.flutterguard.FlutterGuardStartupActivity\"\n      topic=\"com.intellij.openapi.project.DumbAware\"/>\n  </projectListeners>\n</idea-plugin>"
    },
    {
      "id": "3-settings",
      "action": "write_file",
      "target": "idea-plugin/src/main/kotlin/com/flutterguard/FlutterGuardSettings.kt",
      "content": [
        "package com.flutterguard",
        "",
        "import com.intellij.openapi.components.*",
        "import com.intellij.openapi.project.Project",
        "import com.intellij.util.xmlb.XmlSerializerUtil",
        "",
        "@State(name = \"FlutterGuardSettings\", storages = [Storage(\"flutterguard.xml\")])",
        "@Service(Service.Level.PROJECT)",
        "class FlutterGuardSettings : PersistentStateComponent<FlutterGuardSettings> {",
        "    var enabled: Boolean = true",
        "    var scanOnSave: Boolean = true",
        "    var failOnSeverity: String = \"low\"",
        "    var customArgs: String = \"\"",
        "",
        "    override fun getState(): FlutterGuardSettings = this",
        "    override fun loadState(state: FlutterGuardSettings) = XmlSerializerUtil.copyBean(state, this)",
        "",
        "    companion object {",
        "        fun getInstance(project: Project): FlutterGuardSettings =",
        "            project.getService(FlutterGuardSettings::class.java)",
        "    }",
        "}"
      ]
    },
    {
      "id": "4-external-annotator",
      "action": "write_file",
      "target": "idea-plugin/src/main/kotlin/com/flutterguard/FlutterGuardExternalAnnotator.kt",
      "content": [
        "package com.flutterguard",
        "",
        "import com.intellij.lang.annotation.AnnotationHolder",
        "import com.intellij.lang.annotation.ExternalAnnotator",
        "import com.intellij.lang.annotation.HighlightSeverity",
        "import com.intellij.openapi.diagnostic.Logger",
        "import com.intellij.openapi.editor.Editor",
        "import com.intellij.openapi.project.Project",
        "import com.intellij.openapi.util.TextRange",
        "import com.intellij.psi.PsiFile",
        "import com.google.gson.Gson",
        "import com.google.gson.annotations.SerializedName",
        "import java.io.File",
        "import java.util.concurrent.TimeUnit",
        "",
        "class FlutterGuardExternalAnnotator : ExternalAnnotator<PsiFile, List<FlutterGuardExternalAnnotator.Finding>>() {",
        "",
        "    data class Finding(",
        "        val ruleId: String = \"\",",
        "        val title: String = \"\",",
        "        val file: String = \"\",",
        "        @SerializedName(\"fileRelative\") val fileRelative: String = \"\",",
        "        val line: Int = 0,",
        "        val severity: String = \"medium\",",
        "        val domain: String = \"\",",
        "        val message: String = \"\",",
        "        val suggestion: String = \"\"",
        "    )",
        "",
        "    data class Report(",
        "        val issues: List<Finding> = emptyList()",
        "    )",
        "",
        "    private val logger = Logger.getInstance(FlutterGuardExternalAnnotator::class.java)",
        "",
        "    override fun collectInformation(file: PsiFile): PsiFile = file",
        "",
        "    override fun doAnnotate(collectedInfo: PsiFile): List<Finding> {",
        "        val project = collectedInfo.project",
        "        val settings = FlutterGuardSettings.getInstance(project)",
        "        if (!settings.enabled) return emptyList()",
        "",
        "        val basePath = project.basePath ?: return emptyList()",
        "        val binary = resolveBinary() ?: run {",
        "            logger.warn(\"flutterguard binary not found for ${currentPlatform()}\")",
        "            return emptyList()",
        "        }",
        "",
        "        val filePath = collectedInfo.virtualFile.path",
        "",
        "        return try {",
        "            val process = ProcessBuilder(",
        "                binary.absolutePath,",
        "                \"scan\", filePath,",
        "                \"--format\", \"json\", \"--stdout\", \"--no-color\",",
        "                \"--fail-on\", settings.failOnSeverity",
        "            ).directory(File(basePath))",
        "              .redirectErrorStream(true)",
        "              .start()",
        "",
        "            val output = process.inputStream.bufferedReader().readText()",
        "            process.waitFor(30, TimeUnit.SECONDS)",
        "",
        "            if (output.isBlank()) return emptyList()",
        "            Gson().fromJson(output, Report::class.java).issues",
        "        } catch (e: Exception) {",
        "            logger.warn(\"FlutterGuard scan failed\", e)",
        "            emptyList()",
        "        }",
        "    }",
        "",
        "    override fun apply(file: PsiFile, findings: List<Finding>, holder: AnnotationHolder) {",
        "        for (finding in findings) {",
        "            val document = file.viewProvider.document ?: continue",
        "            val lineIdx = (finding.line - 1).coerceIn(0, document.lineCount - 1)",
        "            val start = document.getLineStartOffset(lineIdx)",
        "            val end = document.getLineEndOffset(lineIdx)",
        "            val severity = when (finding.severity) {",
        "                \"high\" -> HighlightSeverity.ERROR",
        "                \"medium\" -> HighlightSeverity.WARNING",
        "                else -> HighlightSeverity.WEAK_WARNING",
        "            }",
        "            holder.newAnnotation(severity, \"[${finding.ruleId}] ${finding.message}\")",
        "                .range(TextRange(start, end))",
        "                .tooltip(\"${finding.title}\\n\\n${finding.suggestion}\")",
        "                .create()",
        "        }",
        "    }",
        "",
        "    private fun resolveBinary(): File? {",
        "        val platform = currentPlatform()",
        "        val resourcePath = \"/bin/flutterguard-$platform\"",
        "        val resource = javaClass.getResource(resourcePath) ?: return null",
        "        return try {",
        "            val tmp = File.createTempFile(\"flutterguard-\", \"\")",
        "            tmp.deleteOnExit()",
        "            javaClass.getResourceAsStream(resourcePath).use { input ->",
        "                tmp.outputStream().use { output -> input.copyTo(output) }",
        "            }",
        "            tmp.setExecutable(true)",
        "            tmp",
        "        } catch (e: Exception) {",
        "            logger.warn(\"Failed to extract native binary\", e)",
        "            null",
        "        }",
        "    }",
        "",
        "    private fun currentPlatform(): String {",
        "        val os = System.getProperty(\"os.name\").lowercase()",
        "        val arch = System.getProperty(\"os.arch\").lowercase()",
        "        val osPart = when {",
        "            os.contains(\"mac\") || os.contains(\"darwin\") -> \"darwin\"",
        "            os.contains(\"win\") -> \"windows\"",
        "            else -> \"linux\"",
        "        }",
        "        val archPart = when {",
        "            arch.contains(\"aarch64\") || arch.contains(\"arm64\") -> \"arm64\"",
        "            else -> \"x64\"",
        "        }",
        "        return \"$osPart-$archPart\"",
        "    }",
        "}"
      ]
    },
    {
      "id": "5-startup-activity",
      "action": "write_file",
      "target": "idea-plugin/src/main/kotlin/com/flutterguard/FlutterGuardStartupActivity.kt",
      "content": [
        "package com.flutterguard",
        "",
        "import com.intellij.openapi.project.Project",
        "import com.intellij.openapi.startup.ProjectActivity",
        "",
        "class FlutterGuardStartupActivity : ProjectActivity {",
        "    override suspend fun execute(project: Project) {",
        "        // Plugin initializes via service components and annotator registration.",
        "        // No eager work needed on startup.",
        "    }",
        "}"
      ]
    },
    {
      "id": "6-update-scripts-agents",
      "action": "patch",
      "path": "scripts/AGENTS.md",
      "old_string": "| `release_preflight.sh` | any | pre-release checks (analyze, test, scan, publish dry-run) |\n\nNo Dart deps. Read version from root pubspec.yaml. Output to dist/.",
      "new_string": "| `release_preflight.sh` | any | pre-release checks (analyze, test, scan, publish dry-run) |\n| `idea_plugin_preflight.sh` | macOS/Linux | validate plugin project, sync native bins, gradle check, verifier |\n| `idea_plugin_publish.sh` | macOS/Linux | preflight gate + gradle publishPlugin to JetBrains Marketplace |\n\nNo Dart deps. Read version from root pubspec.yaml. Output to dist/."
    },
    {
      "id": "7-verify-gradle-wrapper",
      "action": "terminal",
      "command": "cd /Users/forest/code/flutterguard/idea-plugin && gradle wrapper --gradle-version 8.10 2>&1 || echo 'GRADLE_INIT_REQUIRED'"
    }
  ],
  "post_execution": {
    "checks": [
      "idea-plugin/build.gradle.kts exists and is valid Kotlin DSL",
      "idea-plugin/src/main/resources/META-INF/plugin.xml has correct id and Dart language",
      "idea-plugin/src/main/kotlin/com/flutterguard/FlutterGuardExternalAnnotator.kt uses --format json --stdout",
      "idea-plugin/gradlew is executable",
      "bash -n scripts/idea_plugin_preflight.sh passes",
      "bash -n scripts/idea_plugin_publish.sh passes"
    ]
  },
  "native_binary_convention": {
    "description": "Binaries placed in idea-plugin/src/main/resources/bin/ by idea_plugin_preflight.sh before build",
    "naming": {
      "macOS arm64": "flutterguard-darwin-arm64",
      "macOS x64": "flutterguard-darwin-x64",
      "Linux x64": "flutterguard-linux-x64",
      "Windows x64": "flutterguard-windows-x64.exe"
    }
  },
  "publish_flow": [
    "1. Build native binaries on each platform: bash scripts/package_release.sh",
    "2. Collect all binaries under dist/",
    "3. Run preflight: bash scripts/idea_plugin_preflight.sh",
    "4. Publish: bash scripts/idea_plugin_publish.sh"
  ],
  "estimated_changes": {
    "new_dirs": ["idea-plugin/", "idea-plugin/src/main/kotlin/com/flutterguard/", "idea-plugin/src/main/resources/META-INF/", "idea-plugin/src/main/resources/bin/"],
    "new_files": 7,
    "scripts_added": 2,
    "total_kotlin_lines": "~120"
  }
}
